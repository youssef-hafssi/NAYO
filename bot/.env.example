# ---- WhatsApp Cloud API (Meta, official) — README step 1 ----
# Permanent System User token (never commit it)
WHATSAPP_TOKEN=
# "Phone number ID" from WhatsApp → API Setup (not the phone number itself)
WHATSAPP_PHONE_NUMBER_ID=
# Any long random string; you type the same one in the Meta webhook settings
WHATSAPP_VERIFY_TOKEN=
# App settings → Basic → App secret (used to check the X-Hub-Signature-256 header)
WHATSAPP_APP_SECRET=
# Current Graph API version (Nov 2026). Check developers.facebook.com/docs/graph-api/changelog
GRAPH_API_VERSION=v26.0

# ---- Gemini — README step 3 ----
GEMINI_API_KEY=
# Main model + automatic fallback when it is overloaded (tested Nov 2026: 3.6-flash ~2 s, 3.5-flash-lite ~1.5 s;
# 3.8-flash was too overloaded on this key). Check ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# Seconds before a call is abandoned (then the fallback model is tried)
GEMINI_TIMEOUT_S=20
# 0 = no "thinking" (much faster; enough for this task)
GEMINI_THINKING_BUDGET=0

# ---- Google Sheets — README step 2 ----
# The long id in the sheet URL: docs.google.com/spreadsheets/d/<THIS>/edit
GOOGLE_SHEET_ID=
# Path to the service-account key file, or the whole JSON on one line
GOOGLE_SERVICE_ACCOUNT_JSON=service-account.json
# sheets = Google Sheet · db = orders table in the bot database (Supabase → Table Editor → orders)
# csv = local orders.csv file (local tests only: lost on Vercel/Render)
ORDERS_BACKEND=sheets
CSV_PATH=orders.csv
# Optional: copy every order to a Google Sheet through an Apps Script web app (README → "Google Sheet mirror")
SHEET_WEBHOOK_URL=
SHEET_WEBHOOK_SECRET=

# ---- You ----
# Your WhatsApp number, digits only. Alerts arrive here — send the bot a message once a day so the 24h window stays open.
OWNER_WHATSAPP=212663760384
# Same value as VITE_ORDER_API_KEY on the website (a light filter, not real security: it is visible in the site's code)
ORDER_API_KEY=
# Website domains allowed to call /orders (comma-separated, no trailing slash)
ALLOWED_ORIGINS=https://your-site.com,http://localhost:5173

# ---- Bot state ----
# Production: postgres (free Supabase). Free hosts erase their disk on restart, so never sqlite there.
STATE_BACKEND=sqlite
# Supabase → Connect → "Transaction pooler" URI (postgresql://…)
DATABASE_URL=
# Local development only
SQLITE_PATH=bot-state.db

MAX_REPLIES_PER_HOUR=20
MAX_ORDERS_PER_IP_PER_HOUR=10

# Vercel / serverless: process each WhatsApp message before answering Meta. Must be true on Vercel.
PROCESS_INLINE=false
