# Business WhatsApp number (the WhatsApp Cloud API number the bot answers on).
# International format, digits only: 212 + number without the leading 0. Example: 06 63 76 03 84 → 212663760384
VITE_WHATSAPP_NUMBER=212663760384

# The bot's POST /orders URL (see bot/README.md). Example: https://nayo-bot.onrender.com/orders
# Payload: { clientId, orderNumber?, name, phone, quantity, product, unitPrice, subtotal, shipping, total, currency, payment, status, createdAt }
# Reply:   { orderNumber, quantity, total }
VITE_ORDER_ENDPOINT=

# Same value as ORDER_API_KEY in bot/.env. Visible in the site's JavaScript: a light filter, not real security.
VITE_ORDER_API_KEY=
